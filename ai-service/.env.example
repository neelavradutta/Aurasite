FASTAPI_ENV=development
LOG_LEVEL=INFO
# Auto-use NVIDIA GPU when CUDA is available (set false to force CPU)
GPU_ENABLED=true
PORT=5000

# Vehicle detector (COCO — auto-downloads on first run)
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
MIN_BBOX_AREA=2000

# Dedicated plate detector (run scripts/download_models.py)
PLATE_YOLO_MODEL=plate_yolov8n.pt
PLATE_CONFIDENCE_THRESHOLD=0.4
MIN_PLATE_AREA=400

# OCR
OCR_LANG=en
MIN_PLATE_CONFIDENCE=0.7

# Pipeline: auto | plate_first | vehicle_crop
ANPR_PIPELINE=auto

FRAME_SKIP=2
BACKEND_CALLBACK_URL=http://localhost:8000
STREAM_FRAME_INTERVAL=0.5
