PORT=8000
NODE_ENV=development
DATABASE_URL=mysql://anpr_user:anpr_pass@localhost:3306/anpr_db
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=rootpassword
PYTHON_SERVICE_URL=http://localhost:5000
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=2h
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=admin123
AUTH_ENABLED=true
# Set false on Render only if you want to block public sign-up
ALLOW_PUBLIC_REGISTER=true
# Comma-separated — local dev + Vercel production frontend
CORS_ORIGIN=http://localhost:3001,https://aurasitee.vercel.app
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500
